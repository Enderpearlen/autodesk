---
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import { stores } from '../content/stores';
import { copy } from '../content/copy.nl';
const w = copy.pages.where;
const types = Object.entries(w.types);
const typeLabel = (t: string) => (w.types as Record<string, string>)[t];
const mapUrl = (s: (typeof stores)[number]) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([s.name.replace(/\[X[^\]]*\]/g, '').trim(), s.address ?? '', s.city].filter(Boolean).join(' '))}`;
---

<div data-stores>
  <div class="filters" role="group" aria-label={w.filter}>
    <button class="chip" type="button" aria-pressed="true" data-filter="all">{w.all}</button>
    {types.map(([k, label]) => <button class="chip" type="button" aria-pressed="false" data-filter={k}>{label}</button>)}
    <div class="field search">
      <label class="sr-only" for="store-q">{w.search}</label>
      <input id="store-q" type="text" placeholder={w.search} data-store-search autocomplete="off" />
    </div>
  </div>
  <p class="count" role="status" aria-live="polite" data-store-count>{w.count(stores.length)}</p>
  <ul class="store-list">
    {stores.map((s) => (
      <li class="store" data-type={s.type} data-text={`${s.name} ${s.city}`.toLowerCase()}>
        <div>
          <h3><Rich text={s.name} /></h3>
          <span class="meta">{typeLabel(s.type)}, {s.city}</span>
        </div>
        <div></div>
        <div class="actions">
          {s.type !== 'online' && <a class="btn btn--small btn--ghost" href={mapUrl(s)} target="_blank" rel="noopener noreferrer"><Icon name="mapPin" /> {w.route}</a>}
          {s.url && <a class="btn btn--small" href={s.url} target="_blank" rel="noopener noreferrer">{w.visit}</a>}
        </div>
      </li>
    ))}
  </ul>
  <p class="muted" data-store-empty hidden>{w.empty}</p>
</div>
