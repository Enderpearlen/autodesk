---
import { copy } from '../content/copy.nl';
const c = copy.clock;

/** Streepjes van de wijzerplaat: 60 posities, elke vijfde is een uurstreep. */
const ticks = Array.from({ length: 60 }, (_, i) => {
  const a = (i * 6 * Math.PI) / 180;
  const big = i % 5 === 0;
  const r1 = 86;
  const r2 = big ? 74 : 81;
  return { x1: 100 + r1 * Math.sin(a), y1: 100 - r1 * Math.cos(a), x2: 100 + r2 * Math.sin(a), y2: 100 - r2 * Math.cos(a), big };
});
const num = (n: number) => {
  const a = (n * 30 * Math.PI) / 180;
  return { n, x: 100 + 62 * Math.sin(a), y: 100 - 62 * Math.cos(a) + 7 };
};
---

<section class="clock" id="klok" data-clock data-state="done" aria-label={c.time}>
  <div class="container clock-wrap">
    <button class="clock-face" type="button" data-audit-covers data-clock-replay aria-label={c.replay}>
      <svg viewBox="0 0 200 200" role="img" aria-label={c.label} focusable="false">
        <circle class="clock-bg" cx="100" cy="100" r="97" />
        <circle class="clock-gold" cx="100" cy="100" r="91.5" />
        {ticks.map((t) => <line class={t.big ? 'tick tick--big' : 'tick'} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
        {[12, 3, 6, 9].map((n) => { const p = num(n % 12); return <text class="numeral" x={p.x} y={p.y} text-anchor="middle">{n}</text>; })}
        <text class="clock-brand" x="100" y="150" text-anchor="middle">MANDO</text>
        <g class="hand hand-h" data-hand="h" style="transform: rotate(150deg)">
          <path d="M95.2 112 L100 60 L104.8 112 Z" />
        </g>
        <g class="hand hand-m" data-hand="m">
          <path d="M97.5 118 L100 26 L102.5 118 Z" />
        </g>
        <circle class="clock-cap" cx="100" cy="100" r="5.5" />
      </svg>
    </button>
    <p class="clock-text" role="status">
      <span class="clock-t clock-t--wait" aria-hidden="true">{c.watching}</span>
      <span class="clock-t clock-t--done">{c.time}</span>
    </p>
  </div>
</section>
