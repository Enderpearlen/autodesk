---
import { copy } from '../content/copy.nl';
import { stickers } from '../config/visuals';
const items = copy.claims;
---

<section class="claims band-1" aria-label="Kort over Mando">
  <div class="stripe" aria-hidden="true"></div>
  <div class="claims-track">
    {[0, 1].map((n) => (
      <div class="claims-item" aria-hidden={n === 1 ? 'true' : undefined}>
        {items.map((t, i) => (
          <>
            <span>{t}</span>
            <img src={i % 2 ? stickers.zon.src : stickers.amandel.src} alt="" width="40" height="40" loading="lazy" />
          </>
        ))}
      </div>
    ))}
  </div>
  <div class="stripe" aria-hidden="true"></div>
</section>
