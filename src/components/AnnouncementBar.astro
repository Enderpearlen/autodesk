---
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import { announcement } from '../config/site';
import { copy } from '../content/copy.nl';
---

{announcement.enabled && (
  <aside class="announcement" data-announcement aria-label={copy.announcement.label}>
    <div class="container announcement-inner">
      <p>
        <Rich text={announcement.text} />
        {announcement.href && announcement.linkLabel && <><span class="announcement-gap"> </span><a href={announcement.href}>{announcement.linkLabel}</a></>}
      </p>
      {announcement.dismissible && (
        <button class="announcement-close" type="button" data-announcement-close aria-label={copy.announcement.close}>
          <Icon name="x" />
        </button>
      )}
    </div>
  </aside>
)}
