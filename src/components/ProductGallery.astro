---
import type { Img } from '../config/visuals';
import { copy } from '../content/copy.nl';
interface Props { images: Img[] }
const { images } = Astro.props;
const g = copy.pages.product;
const first = images[0];
---

<div class="gallery" data-gallery>
  <div class="frame gallery-main">
    <img data-gallery-main src={first.src} width={first.w} height={first.h} alt={first.alt} fetchpriority="high" decoding="async" />
  </div>
  {images.length > 1 && (
    <div class="thumbs" role="group" aria-label={g.galleryLabel}>
      {images.map((p, i) => (
        <button class="thumb" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-src={p.src} data-alt={p.alt} aria-label={`${g.thumb} ${i + 1}: ${p.alt}`}>
          <img src={p.src} width={p.w} height={p.h} alt="" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}
</div>
