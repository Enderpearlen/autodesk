---
import { copy } from '../content/copy.nl';
import { forms, company } from '../config/site';
import Rich from './Rich.astro';
const c = copy.pages.contact;
---

<form class="form" data-form="contact" data-endpoint={forms.endpoint} data-demo={c.demo} data-ok={c.ok} novalidate>
  <div class="field">
    <label for="c-name">{c.name}</label>
    <input id="c-name" name="name" type="text" autocomplete="name" required aria-describedby="c-name-err" />
    <p class="error" id="c-name-err" hidden></p>
  </div>
  <div class="field">
    <label for="c-email">{c.email}</label>
    <input id="c-email" name="email" type="email" autocomplete="email" required aria-describedby="c-email-err" />
    <p class="error" id="c-email-err" hidden></p>
  </div>
  <div class="field">
    <label for="c-subject">{c.subject}</label>
    <select id="c-subject" name="subject" required aria-describedby="c-subject-err">
      {c.subjects.map((s) => <option value={s}>{s}</option>)}
    </select>
    <p class="error" id="c-subject-err" hidden></p>
  </div>
  <div class="field">
    <label for="c-message">{c.message}</label>
    <textarea id="c-message" name="message" required aria-describedby="c-message-err"></textarea>
    <p class="error" id="c-message-err" hidden></p>
  </div>
  <div class="field">
    <div class="check">
      <input id="c-consent" name="consent" type="checkbox" required aria-describedby="c-consent-err" />
      <label for="c-consent">{c.consentPre}<a href="/juridisch/privacy">{c.consentLink}</a>{c.consentPost}</label>
    </div>
    <p class="error" id="c-consent-err" hidden></p>
  </div>
  <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <p class="form-status" role="status" aria-live="polite" data-status></p>
  <div class="btn-row">
    <button class="btn" type="submit">{copy.ui.send}</button>
    <span class="muted"><Rich text={`${copy.forms.mailtoText}: ${company.email}`} /></span>
  </div>
</form>
