---
import Sticker from './Sticker.astro';
import { lineup } from '../config/visuals';
import { products } from '../content/products';
import { copy } from '../content/copy.nl';
const f = copy.flavours;
---

<section class="section paper feature" id="smaken">
  <div class="container feature-grid">
    <div class="feature-copy stack" data-reveal>
      <p class="kicker">{f.kicker}</p>
      <h2>{f.title}</h2>
      <p class="lead">{f.text}</p>
      <a class="btn btn--ghost" href="/het-blik">{f.cta}</a>
    </div>
    <div class="feature-media" data-reveal style="--d:.1s">
      <img src={lineup.src} width={lineup.w} height={lineup.h} alt={lineup.alt} loading="lazy" decoding="async" />
      <Sticker name="pot" size={130} sizeSm={72} rotate={-4} style="left:-52px;bottom:-30px" />
    </div>
  </div>
  <div class="container">
    <ul class="flavour-row">
      {products.map((p, i) => (
        <li data-reveal style={`--d:${i * 0.06}s`}>
          <a href={`/het-blik/${p.slug}`}>
            <img src={p.can.src} width={p.can.w} height={p.can.h} alt="" loading="lazy" decoding="async" />
            <span class="flavour-name">{p.name}</span>
            <span class="flavour-link">{f.linkLabel}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
