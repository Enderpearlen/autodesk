---
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import { nav, brand, company, socials, nix18 } from '../config/site';
import { themes, themeIds } from '../config/themes';
import { footer, logo } from '../config/visuals';
import { copy } from '../content/copy.nl';

const forTheme = (kind: 'nacht' | 'terra' | 'creme') => themeIds.filter((t) => themes[t].footerImage === kind).join(' ');
const kinds = ['nacht', 'terra', 'creme'] as const;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {kinds.map((k) => (
    <img class="footer-art themed" data-for={forTheme(k)} src={footer[k].src} width={footer[k].w} height={footer[k].h} alt="" aria-hidden="true" loading="lazy" decoding="async" />
  ))}
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="footer-logo" href="/" aria-label={copy.ui.home}>
          <img src={logo.light.src} alt={brand.name} width={logo.light.w} height={logo.light.h} loading="lazy" />
        </a>
        <p class="footer-tag">{copy.footer.tagline}</p>
        <div class="socials">
          {socials.map((s) => (
            <a class="social-link" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label}, ${copy.ui.opensNewTab}`}>
              <Icon name={s.id} />
            </a>
          ))}
        </div>
      </div>
      <div>
        <h2>{copy.footer.help}</h2>
        <ul>{nav.help.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>{brand.name}</h2>
        <ul>{nav.main.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>{copy.footer.legal}</h2>
        <ul>
          {nav.legal.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><button class="link-button" type="button" data-consent-open>{copy.consent.settings}</button></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-18">
        <a class="nix18" href={nix18.href} target="_blank" rel="noopener noreferrer" aria-label={`${copy.footer.nix18}, ${copy.ui.opensNewTab}`}>
          {nix18.logo
            ? <img src={nix18.logo} alt="" width="76" height="76" loading="lazy" decoding="async" />
            : <span class="nix18-badge" aria-hidden="true">{nix18.label}</span>}
        </a>
        <p class="footer-warning">{copy.footer.warning}</p>
      </div>
      <p><Rich text={`© ${year} ${company.legalName}. ${copy.footer.rights} KvK ${company.kvk}, btw ${company.vat}.`} /></p>
    </div>
  </div>
</footer>
