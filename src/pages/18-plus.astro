---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { copy } from '../content/copy.nl';

const a = copy.pages.adult;
---

<Base title={a.title} description={a.description}>
  <PageHeader tone="olijf" title={a.title} />
  <section class="section paper">
    <div class="container narrow stack">
      <p class="lead">{a.lead}</p>
      <ul>{a.points.map((p) => <li>{p}</li>)}</ul>
      <h2 style="font-size:1.6rem">{a.moreTitle}</h2>
      <ul>{a.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>)}</ul>
    </div>
  </section>
</Base>
