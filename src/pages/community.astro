---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SocialFeed from '../components/SocialFeed.astro';
import Icon from '../components/Icon.astro';
import Rich from '../components/Rich.astro';
import { copy } from '../content/copy.nl';
import { socials, hashtags } from '../config/site';

const c = copy.pages.community;
---

<Base title={c.title} description={c.description}>
  <PageHeader tone="olijf" title={c.title} />
  <section class="community section" style="padding-top:clamp(40px,6vw,80px)">
    <div class="container">
      <div class="stack" data-reveal>
        <p class="lead">{c.lead}</p>
        <div class="btn-row">
          {socials.map((s) => (
            <a class="btn" href={s.url} target="_blank" rel="noopener noreferrer"><Icon name={s.id} /> {s.id === 'instagram' ? copy.community.followInstagram : copy.community.followTikTok}</a>
          ))}
        </div>
        <p>{c.embedNote}</p>
        <p>{c.hashtag} <Rich text={hashtags.join(' ')} /></p>
      </div>
      <SocialFeed />
      <p style="margin-top:1.5rem"><Rich text={socials.map((s) => `${s.label}: ${s.handle}`).join(', ')} /></p>
    </div>
  </section>
</Base>
